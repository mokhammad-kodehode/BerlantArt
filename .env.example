# Скопируй в .env.local и заполни. .env.local в git не попадает.
# Номер этапа рядом с блоком — когда переменная реально понадобится (см. ROADMAP.md).

# --- этап 1: базовое ---
# Адрес сайта. Локально оставь как есть, на проде — боевой домен.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- этап 3: база данных (Supabase) — уже нужны, без них не стартует сборка ---
# Обе строки берутся в панели Supabase: Connect -> Prisma.
# Transaction pooler, порт 6543 — по нему работает приложение.
DATABASE_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Порт 5432 — по нему идут миграции Prisma.
DIRECT_URL="postgresql://postgres.<ref>:<PASSWORD>@aws-1-eu-west-1.pooler.supabase.com:5432/postgres"

# --- этап 5: изображения (Cloudflare R2) ---
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# Публичный домен бакета, с него отдаются картинки.
# NEXT_PUBLIC_R2_PUBLIC_URL=""

# --- этап 6: админка ---
# Секрет для подписи сессий: npx auth secret
# AUTH_SECRET=""
# AUTH_ADMIN_EMAIL=""
# bcrypt-хеш пароля, не сам пароль. Генерится скриптом из проекта.
# AUTH_ADMIN_PASSWORD_HASH=""

# --- контакты (используются на страницах) ---
# Телефон в международном формате без плюса и пробелов, например 79991234567
# NEXT_PUBLIC_WHATSAPP_PHONE=""
# NEXT_PUBLIC_CONTACT_EMAIL=""
